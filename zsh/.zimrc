# Core modules
zmodule environment
zmodule git
zmodule input
zmodule termtitle
zmodule utility

# Prompt
zmodule duration-info
zmodule git-info

# Completion
zmodule zsh-users/zsh-completions --fpath src

# Completion must be initialized before the modules below
zmodule completion

# Extras (catppuccin theme is sourced from config.zsh before init)
zmodule zsh-users/zsh-syntax-highlighting
zmodule zsh-users/zsh-history-substring-search
zmodule zsh-users/zsh-autosuggestions
